---
import AppStoreCta from './AppStoreCta.astro';
import { href } from '../lib/url';

const currentPath = Astro.url.pathname;
const links = [
  { label: 'How it works', path: '/how-it-works/' },
  { label: 'FAQ', path: '/faq/' },
  { label: 'Support', path: '/support/' },
  { label: 'Press', path: '/press/' },
];
---

<header class="site-header">
  <div class="header-inner">
    <div class="brand-row">
      <a class="wordmark" href={href('/')} aria-label="Replay Rally home">Replay Rally<span aria-hidden="true"></span></a>
      <div class="mobile-cta"><AppStoreCta compact shortOnMobile /></div>
    </div>
    <nav aria-label="Primary navigation">
      {links.map((link) => (
        <a href={href(link.path)} aria-current={currentPath === href(link.path) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="desktop-cta"><AppStoreCta compact shortOnMobile /></div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(10, 10, 11, 0.96);
  }

  .header-inner {
    width: min(calc(100% - 48px), var(--content-width));
    margin: 0 auto;
    padding-block: 1.15rem 1rem;
  }

  .brand-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    font-size: 1.1rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 12px rgba(255, 214, 10, 0.5);
  }

  nav {
    display: flex;
    gap: 0.9rem 1.25rem;
    align-items: center;
    margin-block-start: 1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  nav a {
    flex: none;
    color: #d2d2d7;
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--yellow);
  }

  .desktop-cta {
    display: none;
  }

  @media (min-width: 800px) {
    .header-inner {
      display: grid;
      width: min(calc(100% - 96px), var(--content-width));
      min-height: 78px;
      grid-template-columns: 1fr auto 1fr;
      gap: 2rem;
      align-items: center;
      padding-block: 0.9rem;
    }

    nav {
      gap: 1.75rem;
      margin: 0;
    }

    .mobile-cta {
      display: none;
    }

    .desktop-cta {
      display: flex;
      justify-content: flex-end;
    }
  }

  @media (max-width: 430px) {
    .mobile-cta {
      max-width: 178px;
    }

    nav {
      gap: 1rem;
    }
  }
</style>
