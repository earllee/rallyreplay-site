---
import { href } from '../lib/url';

interface AnswerLink {
  label: string;
  url: string;
}

interface QaItem {
  question: string;
  answer: string;
  answerParts?: readonly (string | AnswerLink)[];
}

interface Props {
  items: readonly QaItem[];
  columns?: boolean;
}

const { items, columns = false } = Astro.props;
---

<div class:list={['qa-list', { columns }]}>
  {items.map((item) => (
    <article>
      <h3>{item.question}</h3>
      <p>
        {item.answerParts
          ? item.answerParts.map((part) =>
              typeof part === 'string' ? part : (
                <a href={part.url.startsWith('/') ? href(part.url) : part.url}>{part.label}</a>
              ),
            )
          : item.answer}
      </p>
    </article>
  ))}
</div>

<style>
  .qa-list {
    max-width: 860px;
  }

  article {
    padding-block: 1.65rem;
    border-top: 1px solid var(--panel-2);
  }

  article:last-child {
    border-bottom: 1px solid var(--panel-2);
  }

  h3,
  p {
    max-width: 44rem;
  }

  p {
    margin: 0;
    color: #c7c7cc;
  }

  p a {
    font-weight: 650;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  @media (min-width: 820px) {
    .columns {
      display: grid;
      max-width: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2.5rem, 6vw, 6rem);
    }

    .columns article:nth-last-child(2) {
      border-bottom: 1px solid var(--panel-2);
    }
  }
</style>
