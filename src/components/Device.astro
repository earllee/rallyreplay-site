---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  landscape?: boolean;
  hero?: boolean;
  priority?: boolean;
}

const { src, alt, caption, landscape = false, hero = false, priority = false } = Astro.props;
const imageWidth = landscape ? 1368 : hero ? 840 : 720;
---

<figure class:list={['device-figure', { landscape, hero }]}>
  <div class="device">
    <Image
      src={src}
      alt={alt}
      width={imageWidth}
      format="avif"
      quality={82}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .device-figure {
    width: min(100%, 360px);
    margin: 0;
  }

  .device-figure.hero {
    width: min(100%, 420px);
  }

  .device {
    padding: 12px;
    overflow: hidden;
    border-radius: 56px;
    background: var(--panel);
    box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.1), 0 40px 80px rgba(0, 0, 0, 0.6);
  }

  .device :global(img) {
    width: 100%;
    border-radius: 46px;
  }

  figcaption {
    max-width: 34ch;
    margin: 1.35rem auto 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.45;
    text-align: center;
  }

  .landscape {
    width: min(100%, 800px);
  }

  .landscape .device {
    border-radius: 44px;
  }

  .landscape .device :global(img) {
    border-radius: 34px;
  }

</style>
