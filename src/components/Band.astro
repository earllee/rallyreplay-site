---
interface Props {
  dots?: 2 | 3 | 4;
}

const { dots = 3 } = Astro.props;
---

<mark class="band">
  <slot />
  <span class="dots" aria-hidden="true">
    {Array.from({ length: dots }, (_, index) => <i style={`--dot-index:${index}`} />)}
  </span>
</mark>

<style>
  .band {
    position: relative;
    display: inline;
    padding: 0 0.16em;
    border-radius: 0.35em;
    background: var(--band);
    box-decoration-break: clone;
    color: inherit;
    white-space: nowrap;
    -webkit-box-decoration-break: clone;
  }

  .dots {
    position: absolute;
    right: 0.2em;
    bottom: -0.06em;
    left: 0.2em;
    display: flex;
    justify-content: space-evenly;
    pointer-events: none;
  }

  i {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 10px rgba(255, 214, 10, 0.28);
  }
</style>
