---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { href } from '../lib/url';

interface Props {
  title: string;
  description: string;
  path: string;
  home?: boolean;
  pageJsonLd?: Record<string, unknown> | readonly Record<string, unknown>[];
}

const { title, description, path, home = false, pageJsonLd } = Astro.props;
const documentTitle = home ? title : `${title} — Rally Replay`;
const siteUrl = new URL(href('/'), Astro.site).href;
const canonicalUrl = new URL(href(path), Astro.site).href;
const iconUrl = new URL(href('/brand/icon-1024.png'), Astro.site).href;
const ogImageUrl = new URL(href('/brand/og-default.png'), Astro.site).href;

const organization = {
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: 'Rally Replay',
  url: siteUrl,
  logo: iconUrl,
  founder: { '@type': 'Person', name: 'Earl Lee' },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'earlvlee@gmail.com',
    contactType: 'customer support',
  },
};

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Rally Replay',
      url: siteUrl,
      publisher: { '@id': `${siteUrl}#organization` },
    },
    organization,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={iconUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rally Replay" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="Rally Replay — skip to the good parts of your pickleball videos" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <JsonLd data={siteJsonLd} />
    {pageJsonLd && <JsonLd data={pageJsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 1rem;
    left: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: var(--yellow);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    color: var(--bg);
    transform: translateY(0);
  }
</style>
